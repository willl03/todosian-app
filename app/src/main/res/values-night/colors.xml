<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Used by the Activity window before Compose draws (avoids flash). -->
    <color name="window_background">#FF141218</color>
    <!-- Priority palette mirrors values/colors.xml so the dots read the same in dark mode:
         P1 red, P2 yellow, P3 blue, legacy low/lowest in greys. -->
    <color name="priority_lowest">#6B7280</color>
    <color name="priority_low">#9AA0A6</color>
    <color name="priority_medium">#2F80ED</color>
    <color name="priority_high">#FDE68A</color>
    <color name="priority_highest">#E03829</color>
</resources>
